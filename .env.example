DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
SETUP_SECRET=replace-with-a-long-random-secret
SEED_ADMIN_EMAIL=your-private-admin-email@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-unique-password
SEED_STUDENT_EMAIL=student@storysprint.local
SEED_STUDENT_PASSWORD=replace-with-a-strong-demo-password

# Supabase project URL is public and is used only for direct browser uploads.
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
# Server-only. Never expose this value to browser code or NEXT_PUBLIC variables.
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-staging-service-role-key
SUPABASE_DOCUMENT_BUCKET=course-documents
